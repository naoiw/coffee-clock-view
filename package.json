{
  "name": "coffee-clock-view",
  "version": "1.0.0",
  "private": true,
  "description": "CoffeeScript and Canvas clock",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "coffee -c -o dist src/clock.coffee && node -e \"require('node:fs').copyFileSync('src/styles.css', 'dist/styles.css')\"",
    "dev": "pnpm run build && pnpm run serve",
    "serve": "serve . -l 3000",
    "start": "pnpm run dev",
    "test": "node --require coffeescript/register --test tests/*.test.coffee",
    "check": "pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "coffeescript": "^2.7.0",
    "serve": "^14.2.4"
  }
}
